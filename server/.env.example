# =================================================================
# AGRIDRONE HUB - ENVIRONMENT TEMPLATE
# =================================================================

PORT=5000

# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/drone_service_db

# Or MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/drone_service_db?retryWrites=true&w=majority

JWT_SECRET=agridrone_jwt_secret_key_2026_super_secure_key
NODE_ENV=development

# Weather API (OpenWeatherMap)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

